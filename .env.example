# Local: copy this file to .env.local. Production: set the same keys in Vercel.
# Never prefix secrets with NEXT_PUBLIC_. Keep .env.local out of Git.
APP_URL="http://localhost:3000"
# Reusable registration invite; set server-side and rotate here when needed.
REGISTRATION_INVITE_CODE=""

# Supabase PostgreSQL runtime (Transaction pooler / 6543).
# Copy the real URI from Supabase Connect; percent-encode password characters.
DATABASE_URL=""
# Direct database / Session pooler (5432), used only by explicit migration scripts.
DIRECT_URL=""

# Legacy email-auth configuration (not required for invitation + password login).
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# DeepSeek: fill your API key here; all calls are server-side.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
# Official default verified 2026-10-23; editable without changing source.
DEEPSEEK_MODEL="deepseek-flash"
